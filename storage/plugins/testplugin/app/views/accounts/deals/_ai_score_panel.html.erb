<div class="bg-light-palette-p5 border-2 border-light-palette-p3 rounded-md px-4 py-3 mb-4">
  <div class="flex items-center justify-between mb-2">
    <h3 class="typography-body-s-lh150 text-dark-gray-palette-p1 font-semibold flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
      </svg>
      AI Powered Scoring
    </h3>
    <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded text-[10px] font-medium bg-brand-palette-03 text-white">
      NEW
    </span>
  </div>
  <% if deal.ai_score > 0 %>
    <div class="flex items-center gap-3">
      <div class="flex-1">
        <div class="flex justify-between mb-1">
          <span class="typography-body-800 text-dark-gray-palette-p2">Score</span>
          <span class="typography-body-900 text-dark-gray-palette-p1 font-semibold"><%= deal.ai_score %>%</span>
        </div>
        <div class="w-full bg-gray-200 rounded-full h-2">
          <div class="bg-green-600 h-2 rounded-full" style="width: <%= deal.ai_score %>%"></div>
        </div>
      </div>
      <div class="px-3 py-1 rounded text-sm font-medium <%= case deal.ai_score_label
        when 'Very Hot' then 'bg-red-100 text-red-800'
        when 'Hot' then 'bg-orange-100 text-orange-800'
        when 'Warm' then 'bg-yellow-100 text-yellow-800'
        when 'Cold' then 'bg-blue-100 text-blue-800'
        else 'bg-gray-100 text-gray-800'
      end %>">
        <%= deal.ai_score_label %>
      </div>
    </div>
    <div class="mt-3 pt-3 border-t border-light-palette-p3 flex gap-4">
      <div class="text-center">
        <p class="typography-micro-s-lh150 text-dark-gray-palette-p3">Events</p>
        <p class="typography-body-900 text-dark-gray-palette-p1"><%= deal.deal_ai_score&.events_count || 0 %></p>
      </div>
      <div class="text-center">
        <p class="typography-micro-s-lh150 text-dark-gray-palette-p3">Days Since Last</p>
        <p class="typography-body-900 text-dark-gray-palette-p1"><%= deal.deal_ai_score&.days_since_last_event || 0 %></p>
      </div>
    </div>
  <% else %>
    <p class="typography-body-r-lh150 text-dark-gray-palette-p3">No scoring data available yet. Score will be calculated based on customer events.</p>
  <% end %>
</div>
